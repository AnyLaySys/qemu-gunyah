              'slot-type': 'ACPISlotType',
              'source': 'int',
              'status': 'int' } }

{ 'command': 'query-acpi-ospm-status', 'returns': ['ACPIOSTInfo'] }

{ 'event': 'ACPI_DEVICE_OST',
     'data': { 'info': 'ACPIOSTInfo' } }
